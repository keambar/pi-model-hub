{
  "name": "pi-model-hub",
  "version": "0.1.4",
  "description": "Manage LLM model providers from multiple local files and remote URLs in pi-coding-agent",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/index.ts"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "test": "node --experimental-transform-types --test test/index.test.ts",
    "check": "tsc --noEmit && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "pi-coding-agent",
    "extension",
    "llm",
    "model-provider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keambar/pi-model-hub.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
